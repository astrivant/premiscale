{
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "premiscale.com/v1alpha1"
    },
    "kind": {
      "type": "string",
      "const": "ControllerConfig"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "observedGeneration": {
          "type": "integer",
          "format": "int64",
          "minimum": 0
        },
        "configurationDigest": {
          "type": "string"
        },
        "configMapRef": {
          "type": "object",
          "required": [
            "name",
            "key"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "status",
              "reason",
              "message",
              "observedGeneration",
              "lastTransitionTime"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "True",
                  "False",
                  "Unknown"
                ]
              },
              "reason": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "observedGeneration": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "lastTransitionTime": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "pidFile": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "kubernetes",
            "standalone",
            "standalone-external-metrics",
            "kubernetes-external-metrics"
          ]
        },
        "kubernetes": {
          "type": "object",
          "properties": {
            "autoscalerPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "autoscalerHost": {
              "type": "string",
              "minLength": 1
            },
            "providerHost": {
              "type": "string",
              "minLength": 1
            },
            "providerPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "clusterName": {
              "type": "string",
              "minLength": 1
            },
            "stateFile": {
              "type": "string",
              "minLength": 1
            },
            "stateDsn": {
              "type": "string",
              "description": "PostgreSQL operation and volume journal DSN, supporting environment references. Required for HA."
            },
            "providerCert": {
              "type": "string"
            },
            "providerKey": {
              "type": "string"
            },
            "clientCA": {
              "type": "string"
            },
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          },
          "required": [
            "autoscalerPort",
            "autoscalerHost"
          ],
          "additionalProperties": false
        },
        "healthcheck": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "apiPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 9090
            },
            "stateDirectory": {
              "type": "string",
              "minLength": 1,
              "description": "Parent directory for private per-run shared process observations."
            }
          },
          "required": [
            "host",
            "port"
          ],
          "additionalProperties": false
        },
        "kafka": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "bootstrapServers": {
              "type": "string"
            },
            "topic": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,180}$"
            },
            "groupPrefix": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,180}$"
            },
            "options": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "databases": {
          "type": "object",
          "properties": {
            "collectionInterval": {
              "type": "integer",
              "minimum": 5
            },
            "hostConnectionTimeout": {
              "type": "integer",
              "minimum": 1
            },
            "maxHostConnectionThreads": {
              "type": "integer",
              "minimum": 1
            },
            "state": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "memory",
                    "mysql"
                  ]
                },
                "dbfile": {
                  "type": "string",
                  "minLength": 1
                },
                "connection": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "database": {
                      "type": "string",
                      "minLength": 1
                    },
                    "credentials": {
                      "type": "object",
                      "properties": {
                        "username": {
                          "type": "string",
                          "minLength": 0
                        },
                        "password": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "username",
                        "password"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "url",
                    "database",
                    "credentials"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            },
            "timeseries": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "memory"
                  ]
                },
                "retention": {
                  "type": "integer",
                  "minimum": 300
                },
                "dbfile": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "type",
                "retention"
              ],
              "additionalProperties": false
            },
            "publishers": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "memory",
                      "postgresql",
                      "influxdb"
                    ]
                  },
                  "retention": {
                    "type": "integer",
                    "minimum": 300
                  },
                  "dbfile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dsn": {
                    "type": "string",
                    "minLength": 1
                  },
                  "connectTimeout": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "statementTimeout": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "organization": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bucket": {
                    "type": "string",
                    "minLength": 1
                  },
                  "token": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timeoutSeconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "caFile": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              }
            },
            "hostConnectionQueueSize": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "collectionInterval",
            "hostConnectionTimeout",
            "maxHostConnectionThreads",
            "state",
            "timeseries"
          ],
          "additionalProperties": false
        },
        "platform": {
          "type": "object",
          "properties": {
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "token": {
              "type": "string",
              "minLength": 1
            },
            "certificates": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            },
            "actionsQueueMaxSize": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "domain",
            "token",
            "certificates",
            "actionsQueueMaxSize"
          ],
          "additionalProperties": false
        },
        "reconciliation": {
          "type": "object",
          "properties": {
            "interval": {
              "type": "integer",
              "minimum": 5
            },
            "collection": {
              "type": "object",
              "properties": {
                "minThreads": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                },
                "initialThreads": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 1
                },
                "targetThroughput": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "proportionalGain": {
                  "type": "number",
                  "minimum": 0,
                  "default": 1.0
                },
                "integralGain": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0.1
                },
                "derivativeGain": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0.05
                },
                "smoothing": {
                  "type": "number",
                  "maximum": 1,
                  "default": 0.3,
                  "exclusiveMinimum": 0
                },
                "deadband": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0.1,
                  "exclusiveMaximum": 1
                },
                "maxStep": {
                  "type": "integer",
                  "minimum": 1,
                  "default": 2
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "interval"
          ],
          "additionalProperties": false
        },
        "autoscale": {
          "type": "object",
          "properties": {
            "hosts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
              },
              "description": "Names of Host resources in this namespace.",
              "uniqueItems": true
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
              },
              "description": "Names of AutoscalingGroup resources in this namespace.",
              "uniqueItems": true
            }
          },
          "required": [
            "hosts",
            "groups"
          ],
          "additionalProperties": false
        },
        "broker": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "leaseSeconds": {
              "type": "integer",
              "minimum": 3
            },
            "blockMilliseconds": {
              "type": "integer",
              "minimum": 1
            },
            "connectTimeout": {
              "type": "number",
              "minimum": 0.001
            },
            "socketTimeout": {
              "type": "number",
              "minimum": 0.001
            },
            "caFile": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "pidFile",
        "mode",
        "kubernetes",
        "healthcheck",
        "databases",
        "platform",
        "reconciliation",
        "autoscale"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ControllerConfig"
}
